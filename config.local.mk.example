# Copy this file to config.local.mk and adjust the path for your machine.
#
# The SDK targets SDCC 2.9.0.
# Point this to the original SDCC 2.9.0 bin directory.
# Typical contents are:
#   sdcc or sdcc-2.9.0
#   sdcpp-2.9.0
#   as-z80-2.9.0 (or sdasz80 in repackaged toolchains)
#   sdcclib-2.9.0 (or sdar in repackaged toolchains)
#   link-z80-2.9.0 (or sdldz80 in repackaged toolchains)

SDCC290_BIN_DIR := /absolute/path/to/sdcc-2.9.0/bin

# Optional: switch the compiler optimization profile.
# SDCC_OPT := --opt-code-size
